# Stage 1: Build
FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y \
    build-essential cmake git libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone https://github.com/ggerganov/llama.cpp.git .

# Compilamos y usamos el comando 'install' para agrupar todo
RUN mkdir build && cd build && \
    cmake .. -DGGML_NATIVE=ON -DGGML_OPENMP=ON -DLLAMA_CURL=ON && \
    cmake --build . --config Release --target llama-server && \
    cmake --install . --prefix /app/install

# Stage 2: Runtime
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y \
    libcurl4 libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiamos todo lo que CMake instaló (binarios y librerías)
COPY --from=build /app/install/ /usr/local/

# Actualizamos el caché de librerías del sistema
RUN ldconfig

EXPOSE 8080

ENTRYPOINT ["llama-server"]
