# Stage 1: Build
FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y \
    build-essential cmake git libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone https://github.com/ggerganov/llama.cpp.git .
RUN mkdir build && cd build && \
    cmake .. -DGGML_NATIVE=ON -DGGML_OPENMP=ON -DLLAMA_CURL=ON && \
    cmake --build . --config Release --target llama-server

# Stage 2: Runtime
FROM ubuntu:24.04

# Instalamos lo básico
RUN apt-get update && apt-get install -y \
    libcurl4 libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# COPIAMOS EL BINARIO
COPY --from=build /app/build/bin/llama-server /app/llama-server

COPY --from=build /usr/lib/aarch64-linux-gnu/libmtmd* /usr/lib/aarch64-linux-gnu/
# Actualizamos el cache de librerías del sistema para que las encuentre
RUN ldconfig

EXPOSE 8080
ENTRYPOINT ["/app/llama-server"]
